# Copy this file to .env and fill in values. Never commit .env.

# Required to talk to the LLM. The app will not start chat or evals without it.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# PayPal sandbox credentials from https://developer.paypal.com/
# Apps & Credentials -> Sandbox -> Create app -> Client ID and Secret.
# If these are unset, TillGuard runs in mock mode and still works end to end.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Force a mode even when credentials are present. Use "mock" or "sandbox".
# Default: sandbox if both PayPal vars are set, otherwise mock.
# PAYPAL_MODE=mock

# Optional bind settings for the web UI.
# TILLGUARD_HOST=127.0.0.1
# TILLGUARD_PORT=8000
