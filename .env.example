# Copy this file to .env and fill in values. Never commit .env.

# Preferred LLM. If GEMINI_API_KEY is set, {{PRODUCT_NAME}} uses Gemini by default.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional fallback if Gemini is not set.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Force a provider when both keys are present: gemini or openai.
# DESK_LLM=gemini

# PayPal sandbox credentials from https://developer.paypal.com/
# Apps & Credentials -> Sandbox -> Create app -> Client ID and Secret.
# If these are unset, {{PRODUCT_NAME}} runs in mock mode and still works end to end.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Force a mode even when credentials are present. Use "mock" or "sandbox".
# Default: sandbox if both PayPal vars are set, otherwise mock.
# PAYPAL_MODE=mock

# Optional key used to HMAC-sign the audit chain. If unset, a random key is
# generated at process start. Set this only if you need a stable key across restarts.
# DESK_AUDIT_KEY=

# Optional bind settings for the web UI.
# DESK_HOST=127.0.0.1
# DESK_PORT=8000
